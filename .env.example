# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and run. These defaults work with NO credentials:
#   cp .env.example .env && pnpm install --frozen-lockfile && pnpm demo:seed && pnpm dev
# ─────────────────────────────────────────────────────────────────────────────

# Which language model to use, as "<provider>:<model>".
#   mock:demo               deterministic, offline, no API key (DEFAULT)
#   openai:gpt-5-mini       requires OPENAI_API_KEY
#   anthropic:claude-sonnet-5  requires ANTHROPIC_API_KEY
#
# Leave as mock:demo unless you have credentials. All tests, the seeded demo and
# the clean-room check are designed to pass in this mode.
MODEL_REF=mock:demo

# Required only when MODEL_REF points at that provider. Never commit a real key.
# Leave these COMMENTED OUT when unused. An empty value is not the same as an
# absent one: provider SDKs build a default client at import time, and an empty
# base URL makes that import throw.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override provider base URLs (proxies, gateways, self-hosted).
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

# Where file-backed data lives. Relative to the project root.
DATA_DIR=./data

# Default UI language: kk | ru | en
DEFAULT_LOCALE=ru

# HTTP port for `pnpm start`.
PORT=3000

# Shown on /api/health so a judge can confirm which build they are running.
APP_VERSION=0.1.0
